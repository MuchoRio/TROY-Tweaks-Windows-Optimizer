<Application x:Class="NRTX.Optimizer.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NRTX.Optimizer.Gui"
             xmlns:conv="clr-namespace:NRTX.Optimizer.Gui.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:NavActiveBackgroundConverter x:Key="NavActiveBackgroundConverter"/>
        <conv:NavActiveForegroundConverter x:Key="NavActiveForegroundConverter"/>
        <conv:NavActiveFontWeightConverter x:Key="NavActiveFontWeightConverter"/>
        <conv:PrivilegeForegroundConverter x:Key="PrivilegeForegroundConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:HealthScoreForegroundConverter x:Key="HealthScoreForegroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        
        <!-- Global remove dotted focus box -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Color Palette -->
        <Color x:Key="ColorBgDarkPrimary">#090d16</Color>
        <Color x:Key="ColorBgDarkSecondary">#0f172a</Color>
        <Color x:Key="ColorBgCard">#1e293b</Color>
        <Color x:Key="ColorBgCardHover">#273549</Color>
        <Color x:Key="ColorBorder">#334155</Color>
        
        <Color x:Key="ColorAccentCyan">#38bdf8</Color>
        <Color x:Key="ColorAccentPurple">#a855f7</Color>
        <Color x:Key="ColorAccentGreen">#10b981</Color>
        <Color x:Key="ColorAccentRose">#f43f5e</Color>
        
        <SolidColorBrush x:Key="BrushBgDarkPrimary" Color="{StaticResource ColorBgDarkPrimary}"/>
        <SolidColorBrush x:Key="BrushBgDarkSecondary" Color="{StaticResource ColorBgDarkSecondary}"/>
        <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource ColorBgDarkPrimary}"/>
        <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgDarkSecondary}"/>
        <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
        <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}"/>
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
        
        <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}"/>
        <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}"/>
        <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource ColorAccentGreen}"/>
        <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource ColorAccentRose}"/>
        
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#f8fafc"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#94a3b8"/>
        <SolidColorBrush x:Key="BrushTextDim" Color="#64748b"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushBgCardHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushBgDarkSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryAccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284c7" Offset="0"/>
                        <GradientStop Color="#7c3aed" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#881337"/>
            <Setter Property="BorderBrush" Value="#f43f5e"/>
            <Setter Property="Foreground" Value="#ffe4e6"/>
        </Style>

        <!-- Modern ToggleSwitch Style for CheckBox -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="24">
                            <Border x:Name="Track" Background="#334155" CornerRadius="12" BorderThickness="1" BorderBrush="#475569"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#94a3b8" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#34d399"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToggleSwitch Style for ToggleButton -->
        <Style x:Key="ModernToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="46" Height="24">
                            <Border x:Name="Track" Background="#334155" CornerRadius="12" BorderThickness="1" BorderBrush="#475569"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#94a3b8" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccentGreen}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#34d399"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sleek Nav Pill Button (Zero Dotted Focus, High-Contrast Glow) -->
        <Style x:Key="NavPillButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
