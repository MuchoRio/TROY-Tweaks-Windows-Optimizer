<Window x:Class="NRTX.Optimizer.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NRTX.Optimizer.Gui.ViewModels"
        mc:Ignorable="d"
        Title="TROY Tweaks Windows Optimizer Community Edition v5.4.1" 
        Height="780" Width="1180"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app_icon.ico"
        Background="{StaticResource BrushBgMain}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Main Outer Window Layout -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation -->
            <ColumnDefinition Width="260"/>
            <!-- Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- SIDEBAR NAVIGATION                             -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <!-- Branding Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#0f172a" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="Assets/app_logo.png" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TROY TWEAKS" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushAccentCyan}"/>
                            <TextBlock Text="Windows Optimizer · Community" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,16,0,0" Background="{StaticResource BrushBorder}"/>
                </StackPanel>

                <!-- Footer / Status & Admin Relaunch -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border Background="#1e293b" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding PrivilegeHeader}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                            <TextBlock Text="{Binding PrivilegeStatusText}" 
                                       FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{Binding Specs.IsAdmin, Converter={StaticResource PrivilegeForegroundConverter}}"
                                       Margin="0,2,0,6"/>
                            <Button Style="{StaticResource ModernButton}" 
                                    Content="{Binding PrivilegeBtnRelaunch}"
                                    Command="{Binding RelaunchAsAdminCommand}"
                                    Visibility="{Binding PrivilegeRelaunchVisibility}"
                                    Padding="8,6" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v5.4.1 · Community Edition · C# .NET 10" FontSize="10" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel>
                    <TextBlock Text="{Binding NavHeader}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="4,0,0,8"/>
                    
                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Dashboard"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Dashboard'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Dashboard'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Dashboard'}">
                        <TextBlock Text="{Binding NavDashboard}"/>
                    </Button>
                    
                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Tweaks"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Tweaks'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Tweaks'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Tweaks'}">
                        <TextBlock Text="{Binding NavTweaks}"/>
                    </Button>

                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Profiles"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Profiles'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Profiles'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Profiles'}">
                        <TextBlock Text="{Binding NavProfiles}"/>
                    </Button>

                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Cleaner"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Cleaner'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Cleaner'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Cleaner'}">
                        <TextBlock Text="{Binding NavCleaner}"/>
                    </Button>

                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Startup"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Startup'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Startup'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Startup'}">
                        <TextBlock Text="{Binding NavStartup}"/>
                    </Button>

                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Safety"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Safety'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Safety'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Safety'}">
                        <TextBlock Text="{Binding NavSafety}"/>
                    </Button>

                    <Button Style="{StaticResource NavPillButton}" Command="{Binding SetNavigationCommand}" CommandParameter="Logs"
                            Background="{Binding SelectedNav, Converter={StaticResource NavActiveBackgroundConverter}, ConverterParameter='Logs'}"
                            Foreground="{Binding SelectedNav, Converter={StaticResource NavActiveForegroundConverter}, ConverterParameter='Logs'}"
                            FontWeight="{Binding SelectedNav, Converter={StaticResource NavActiveFontWeightConverter}, ConverterParameter='Logs'}">
                        <TextBlock Text="{Binding NavLogs}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN CONTENT AREA                              -->
        <!-- ============================================== -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedNav}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <!-- Quick Stats & Language Switcher Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Pill -->
                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="4" Margin="0,0,10,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ModernButton}" Content="EN" 
                                    Command="{Binding SwitchLanguageCommand}" CommandParameter="en"
                                    Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource ModernButton}" Content="ID" 
                                    Command="{Binding SwitchLanguageCommand}" CommandParameter="id"
                                    Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM: " Foreground="{StaticResource BrushTextDim}" FontSize="12"/>
                            <TextBlock Text="{Binding MemStats.PhysicalUsagePercent, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderPlan}" Foreground="{StaticResource BrushTextDim}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Specs.ActivePowerPlan}" FontWeight="Bold" Foreground="{StaticResource BrushAccentPurple}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Dynamic View Switcher -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    
                    <!-- ============================================== -->
                    <!-- VIEW 1: DASHBOARD                              -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Dashboard'}">
                        
                        <!-- Hero Health Score & Quick Actions Banner -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Score Card -->
                            <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" Margin="0,0,16,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DashHealthScore}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding HealthScore}" FontSize="54" FontWeight="Bold" Foreground="{Binding HealthScore, Converter={StaticResource HealthScoreForegroundConverter}}"/>
                                        <TextBlock Text="/100" FontSize="18" Foreground="{StaticResource BrushTextDim}" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HealthScoreStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding HealthScore, Converter={StaticResource HealthScoreForegroundConverter}}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ActiveTweaksSummary}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                    
                                    <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="4" Margin="0,10,0,0" Foreground="{StaticResource BrushAccentCyan}" Background="{StaticResource BrushBorder}" BorderThickness="0" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ScanStatusText}" FontSize="10" Foreground="{StaticResource BrushTextDim}" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="280" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <StackPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryAccentButton}" 
                                                Content="{Binding DashBtnAutoFixAll}"
                                                Command="{Binding QuickAutoFixCommand}"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"
                                                Margin="0,0,0,6"/>

                                        <Button Style="{StaticResource ModernButton}" 
                                                Content="{Binding HealthScanButtonText}"
                                                Command="{Binding RefreshAllTweaksStateCommand}"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Quick Optimization Tools Card -->
                            <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashQuickActions}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,12"/>
                                    
                                    <UniformGrid Columns="2" Rows="2">
                                        <Button Style="{StaticResource ModernButton}" Margin="0,0,6,6" Command="{Binding DeepCleanMemoryCommand}" Padding="10,12">
                                            <TextBlock Text="{Binding DashBtnQuickClean}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>

                                        <Button Style="{StaticResource ModernButton}" Margin="6,0,0,6" Command="{Binding QuickTempCleanCommand}" Padding="10,12">
                                            <TextBlock Text="{Binding DashBtnQuickTempClean}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>

                                        <Button Style="{StaticResource ModernButton}" Margin="0,6,6,0" Command="{Binding CreateRestorePointCommand}" Padding="10,12">
                                            <TextBlock Text="{Binding DashBtnQuickCreateRestore}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>

                                        <Button Style="{StaticResource DangerButton}" Margin="6,6,0,0" Command="{Binding RollbackAllCommand}" Padding="10,12">
                                            <TextBlock Text="{Binding DashBtnQuickRollback}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Hardware Specs Grid -->
                        <TextBlock Text="{Binding DashHardwareSpecs}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <!-- OS -->
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14" Margin="0,0,8,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashOs}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                                    <TextBlock Text="{Binding Specs.OsName}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- CPU -->
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14" Margin="4,0,4,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashCpu}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                                    <TextBlock Text="{Binding Specs.CpuName}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding Specs.CpuArchitectureBadge}" FontSize="11" Foreground="{StaticResource BrushAccentCyan}"/>
                                </StackPanel>
                            </Border>
                            <!-- GPU -->
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14" Margin="4,0,4,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashGpu}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                                    <TextBlock Text="{Binding Specs.GpuName}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding Specs.GpuArchitectureBadge}" FontSize="11" Foreground="{StaticResource BrushAccentGreen}"/>
                                </StackPanel>
                            </Border>
                            <!-- RAM -->
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14" Margin="8,0,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DashRam}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                                    <TextBlock Text="{Binding MemStats.PhysicalTotalGb, StringFormat='{}{0} GB'}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding MemStats.PhysicalAvailableGb, StringFormat='{}Available: {0} GB'}" FontSize="11" Foreground="{StaticResource BrushAccentGreen}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <!-- Live Kernel Latency & Timer Resolution Metric Grid -->
                        <!-- VIP eSports Engine Promotion Banner (Community Edition) -->
                        <Border Background="#131e32" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#38bdf8" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#ec4899" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="NRTX LABS VIP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding DashVipBannerTitle}" FontSize="14" FontWeight="Bold" Foreground="#38bdf8"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DashVipBannerDesc}" 
                                               FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource PrimaryAccentButton}" 
                                        Padding="16,10" 
                                        Content="{Binding DashVipBannerBtn}" 
                                        Command="{Binding OpenVipUpgradeCommand}"
                                        VerticalAlignment="Center" 
                                        Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 2: TWEAKS CATALOG                         -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Tweaks'}">
                        <!-- Search & Filter Bar -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SEARCH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Category Filter Buttons -->
                        <WrapPanel Margin="0,0,0,16">
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksAllCategories}" Command="{Binding FilterCategoryCommand}" CommandParameter="All" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryPrivacy}" Command="{Binding FilterCategoryCommand}" CommandParameter="Privacy" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryPerformance}" Command="{Binding FilterCategoryCommand}" CommandParameter="Performance" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryGaming}" Command="{Binding FilterCategoryCommand}" CommandParameter="Gaming" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryNetwork}" Command="{Binding FilterCategoryCommand}" CommandParameter="Network" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryServices}" Command="{Binding FilterCategoryCommand}" CommandParameter="Services" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryDebloater}" Command="{Binding FilterCategoryCommand}" CommandParameter="Debloater" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource ModernButton}" Content="{Binding TweaksCategoryMaintenance}" Command="{Binding FilterCategoryCommand}" CommandParameter="Maintenance" Margin="0,0,6,6"/>
                        </WrapPanel>

                        <!-- Items List -->
                        <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="16" Margin="0,0,0,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Tweak Info -->
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayCategory}" FontSize="10" FontWeight="Bold" Foreground="#38bdf8"/>
                                                    </Border>
                                                    <Border Background="#1e1e38" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayRisk}" FontSize="10" FontWeight="Bold" Foreground="#10b981"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Purpose}" FontSize="11" Foreground="#38bdf8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Toggle Switch -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource BrushTextDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ToggleButton Style="{StaticResource ModernToggle}" 
                                                              IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                              Command="{Binding ToggleCommand}"
                                                              IsEnabled="{Binding IsBusy, ConverterParameter=Inverse, Converter={x:Null}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 4: PROFILES & PRESETS                     -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Profiles'}">
                        <TextBlock Text="{Binding ProfilesTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="#0f172a" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <Border Background="#334155" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding TweakCount, StringFormat='{}{0} tweaks'}" FontSize="10" Foreground="#38bdf8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Action -->
                                            <Button Grid.Column="2" 
                                                    Style="{StaticResource PrimaryAccentButton}" 
                                                    Content="{Binding DataContext.ProfilesBtnApply, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center" 
                                                    Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 5: DEEP JUNK CLEANER (CCLEANER MODE)      -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Cleaner'}">
                        
                        <!-- Header Banner -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CleanerTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding TotalJunkFormatted}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}"/>
                                        <TextBlock Text="{Binding CleanerFoundSub}" FontSize="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CleanerFoundFilesSummary}" FontSize="12" Foreground="{StaticResource BrushTextDim}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ModernButton}" 
                                            Content="{Binding CleanerBtnRescan}" 
                                            Command="{Binding ScanJunkCommand}"
                                            Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource DangerButton}" 
                                            Content="{Binding CleanerBtnCleanSelected}" 
                                            Command="{Binding CleanSelectedJunkCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Junk Categories Checklist -->
                        <TextBlock Text="{Binding CleanerSelectTargets}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding JunkReports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Size Badge -->
                                            <Border Grid.Column="2" Background="#0f172a" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 6: STARTUP MANAGER                        -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Startup'}">
                        
                        <!-- Header Banner -->
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding StartupTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding StartupSubtitle}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1e293b" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StartupTotalAppsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        </Border>
                                        <Border Background="#064e3b" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="{Binding StartupEnabledAppsSummary}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" 
                                        Content="{Binding StartupBtnRescan}" 
                                        Command="{Binding RefreshStartupItemsCommand}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Startup Items List -->
                        <ItemsControl ItemsSource="{Binding StartupEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Name & Command -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{StaticResource BrushTextDim}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Publisher & Location -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{StaticResource BrushTextDim}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Impact Badge -->
                                            <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#0f172a" CornerRadius="6" Padding="10,4">
                                                <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ImpactColor}"/>
                                            </Border>

                                            <!-- Switch -->
                                            <CheckBox Grid.Column="3" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 7: SAFETY & BACKUPS                       -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Safety'}">
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SafetyRestoreGate}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}"/>
                                <TextBlock Text="{Binding SafetyRestoreDesc}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource PrimaryAccentButton}" Content="{Binding SafetyBtnCreateRestore}" Command="{Binding CreateRestorePointCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SafetyRollbackTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}"/>
                                <TextBlock Text="{Binding SafetyRollbackDesc}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource DangerButton}" Content="{Binding SafetyBtnRollbackAll}" Command="{Binding RollbackAllCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================== -->
                    <!-- VIEW 7: LOGS                                   -->
                    <!-- ============================================== -->
                    <StackPanel Visibility="{Binding SelectedNav, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Logs'}">
                        <Border Background="{StaticResource BrushBgCard}" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LogsTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="{Binding LogsBtnExport}" Command="{Binding ExportLogsToFileCommand}"/>
                            </Grid>
                        </Border>

                        <Border Background="#050811" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" MinHeight="350">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#38bdf8" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Global Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgSidebar}" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>

                    <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Width="150" Height="6" 
                                 Background="#1e293b" Foreground="{StaticResource BrushAccentCyan}" BorderThickness="0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>

